apiVersion: operators.coreos.com/v1alpha1
kind: ClusterServiceVersion
metadata:
  name: app-dashboard-operator.v0.1.0
  namespace: app-dashboard-operator
  annotations:
    alm-examples: |-
      [
        {
          "apiVersion": "dashboard.yamlwrangler.com/v1alpha1",
          "kind": "AppDashboard",
          "metadata": {
            "name": "yamlwrangler"
          },
          "spec": {
            "namespace": "app-dashboard",
            "pluginName": "app-dashboard",
            "displayName": "Yamlwrangler App Dashboard",
            "image": "fumbles/yamlwrangler-dashboard:v1.0.0",
            "replicas": 2,
            "enableConsolePlugin": true
          }
        },
        {
          "apiVersion": "dashboard.yamlwrangler.com/v1alpha1",
          "kind": "DashboardNamespaceConfig",
          "metadata": {
            "name": "sample-dashboard-config",
            "namespace": "default"
          },
          "spec": {
            "enabled": true,
            "discoveryMode": "Merge",
            "apps": {
              "sample-app": {
                "enabled": true,
                "displayName": "Sample App",
                "category": "Services",
                "description": "Sample application managed from a DashboardNamespaceConfig",
                "primaryRoute": "sample-app",
                "customLinks": [
                  {
                    "name": "Documentation",
                    "url": "https://example.com/docs",
                    "description": "External documentation"
                  }
                ]
              }
            }
          }
        },
        {
          "apiVersion": "dashboard.yamlwrangler.com/v1alpha1",
          "kind": "DashboardLink",
          "metadata": {
            "name": "sample-app-docs",
            "namespace": "default"
          },
          "spec": {
            "app": "sample-app",
            "name": "Documentation",
            "category": "Services",
            "url": "https://example.com/docs",
            "description": "External documentation"
          }
        }
      ]
    capabilities: Basic Install
    categories: OpenShift Optional
    containerImage: fumbles/yamlwrangler-operator:v1.0.0
    createdAt: "2026-06-10T00:00:00Z"
    description: Installs the Yamlwrangler App Dashboard OpenShift console plugin and discovers applications from labeled namespaces.
    operators.operatorframework.io/builder: manual
    operators.operatorframework.io/project_layout: go.kubebuilder.io/v4
    repository: https://github.com/fumbles/yamlwrangler-operator
    support: Yamlwrangler
spec:
  displayName: Yamlwrangler App Dashboard Operator
  description: |-
    Installs and manages the Yamlwrangler App Dashboard console plugin for OpenShift.

    ## Quick start

    1. Create an `AppDashboard` instance named `yamlwrangler`. This installs the console plugin workload, registers the `ConsolePlugin`, and enables the dashboard in the OpenShift console.
    2. Open the `App Dashboard` page from the OpenShift console navigation.
    3. Existing dashboard-labeled deployments and standalone custom-link ConfigMaps are imported automatically as operands when the operator sees them.

    ## Show apps on the dashboard

    The dashboard reads apps from deployments labeled `dashboard.yamlwrangler.com/enabled=true`.
    App metadata comes from deployment annotations:

    - `dashboard.yamlwrangler.com/display-name`
    - `dashboard.yamlwrangler.com/category`
    - `dashboard.yamlwrangler.com/description`
    - `dashboard.yamlwrangler.com/app-group`
    - `dashboard.yamlwrangler.com/primary-route`
    - `dashboard.yamlwrangler.com/custom-links`

    You can manage those fields from the Operator UI by creating or editing a `DashboardNamespaceConfig` in the target namespace.

    ## Manage a namespace

    Create a `DashboardNamespaceConfig` in an application namespace to generate and manage `dashboard-config-<namespace>`.

    Use `discoveryMode: Merge` to keep existing config and append discovered deployments.
    Use `discoveryMode: Replace` to rebuild from discovered deployments.
    Use `discoveryMode: None` to manage only the apps declared in the custom resource.

    The operator backfills `DashboardNamespaceConfig` operands from existing `dashboard-config-*` ConfigMaps and from currently labeled deployments, so existing dashboard state can be edited from Installed Operators.

    ## Add links

    Create a `DashboardLink` in the app namespace to add or edit one link.
    Set `spec.app` to the app/deployment key, `spec.name` to the display name, and either `spec.url` for an external URL or `spec.route` for an OpenShift Route in the same namespace.

    Standalone ConfigMaps labeled `dashboard.yamlwrangler.com/type=custom-link` are imported as `DashboardLink` operands. Editing an imported link syncs back to its source ConfigMap.

    ## Group apps

    Use `DashboardAppGroup` to select related deployments by name, label, or regex and apply shared dashboard metadata.
    For manual config, set each child app's `groupWith` to the parent deployment key and set the parent app's `primaryRoute` to the route that should open from the grouped card.

    ## Verify

    Check operands from the CLI:

    ```bash
    oc get appdashboard
    oc get dashboardnamespaceconfigs,dashboardlinks,dashboardappgroups -A
    oc get pods -n app-dashboard
    ```
  icon:
    - base64data: 
      mediatype: image/svg+xml
  maturity: alpha
  version: 0.1.0
  minKubeVersion: 1.26.0
  provider:
    name: Yamlwrangler
  keywords:
    - openshift
    - console
    - dashboard
    - homelab
  links:
    - name: Source
      url: https://github.com/fumbles/yamlwrangler-operator
  maintainers:
    - name: Daniel Riggins
      email: noreply@yamlwrangler.com
  installModes:
    - type: OwnNamespace
      supported: false
    - type: SingleNamespace
      supported: false
    - type: MultiNamespace
      supported: false
    - type: AllNamespaces
      supported: true
  customresourcedefinitions:
    owned:
      - name: appdashboards.dashboard.yamlwrangler.com
        version: v1alpha1
        kind: AppDashboard
        displayName: App Dashboard
        description: Installs and manages the OpenShift console dashboard plugin.
      - name: dashboardappgroups.dashboard.yamlwrangler.com
        version: v1alpha1
        kind: DashboardAppGroup
        displayName: Dashboard App Group
        description: Selects and groups deployments for dashboard display.
      - name: dashboardnamespaceconfigs.dashboard.yamlwrangler.com
        version: v1alpha1
        kind: DashboardNamespaceConfig
        displayName: Dashboard Namespace Config
        description: Generates and manages dashboard ConfigMaps for namespaces.
      - name: dashboardlinks.dashboard.yamlwrangler.com
        version: v1alpha1
        kind: DashboardLink
        displayName: Dashboard Link
        description: Adds or updates a custom dashboard link for an app.
  install:
    strategy: deployment
    spec:
      clusterPermissions:
        - serviceAccountName: app-dashboard-operator
          rules:
            - apiGroups:
                - dashboard.yamlwrangler.com
              resources:
                - dashboardappgroups
                - appdashboards
                - dashboardnamespaceconfigs
                - dashboardlinks
              verbs:
                - get
                - list
                - watch
                - create
                - update
                - patch
                - delete
            - apiGroups:
                - dashboard.yamlwrangler.com
              resources:
                - dashboardappgroups/status
                - appdashboards/status
                - dashboardnamespaceconfigs/status
                - dashboardlinks/status
              verbs:
                - get
                - update
                - patch
            - apiGroups:
                - dashboard.yamlwrangler.com
              resources:
                - dashboardappgroups/finalizers
                - appdashboards/finalizers
                - dashboardnamespaceconfigs/finalizers
                - dashboardlinks/finalizers
              verbs:
                - update
            - apiGroups:
                - apps
              resources:
                - deployments
              verbs:
                - get
                - list
                - watch
                - create
                - update
                - patch
            - apiGroups:
                - ""
              resources:
                - namespaces
              verbs:
                - get
                - list
                - watch
                - create
                - update
                - patch
            - apiGroups:
                - ""
              resources:
                - serviceaccounts
                - services
                - configmaps
              verbs:
                - get
                - list
                - watch
                - create
                - update
                - patch
                - delete
            - apiGroups:
                - route.openshift.io
              resources:
                - routes
              verbs:
                - get
                - list
                - watch
            - apiGroups:
                - console.openshift.io
              resources:
                - consoleplugins
                - consolelinks
              verbs:
                - get
                - list
                - watch
                - create
                - update
                - patch
                - delete
            - apiGroups:
                - operator.openshift.io
              resources:
                - consoles
              verbs:
                - get
                - list
                - watch
                - update
                - patch
            - apiGroups:
                - ""
              resources:
                - events
              verbs:
                - create
                - patch
            - apiGroups:
                - coordination.k8s.io
              resources:
                - leases
              verbs:
                - get
                - list
                - watch
                - create
                - update
                - patch
                - delete
      deployments:
        - name: app-dashboard-operator
          spec:
            replicas: 1
            selector:
              matchLabels:
                app: app-dashboard-operator
            template:
              metadata:
                labels:
                  app: app-dashboard-operator
              spec:
                serviceAccountName: app-dashboard-operator
                containers:
                  - name: manager
                    image: fumbles/yamlwrangler-operator:v1.0.0
                    imagePullPolicy: IfNotPresent
                    command:
                      - /manager
                    args:
                      - --leader-elect
                    ports:
                      - containerPort: 8080
                        name: metrics
                        protocol: TCP
                      - containerPort: 8081
                        name: health
                        protocol: TCP
                    livenessProbe:
                      httpGet:
                        path: /healthz
                        port: health
                      initialDelaySeconds: 15
                      periodSeconds: 20
                    readinessProbe:
                      httpGet:
                        path: /readyz
                        port: health
                      initialDelaySeconds: 5
                      periodSeconds: 10
                    resources:
                      limits:
                        cpu: 500m
                        memory: 256Mi
                      requests:
                        cpu: 100m
                        memory: 128Mi
                    securityContext:
                      allowPrivilegeEscalation: false
                      capabilities:
                        drop:
                          - ALL
                      runAsNonRoot: true
                      seccompProfile:
                        type: RuntimeDefault
                securityContext:
                  runAsNonRoot: true
